{% extends "@Contao/frontend_module/default.html.twig" %}

{% block content %}
    {% if empty is defined and empty %}
        <p class="mod_find_your_rep_empty">{{ empty }}</p>
    {% else %}
        <div class="mod_find_your_rep_map">
            <div id="map-container"></div>
        </div>
        <div class="mod_find_your_rep">
            <div class="rep_list">
                <h2 id="state_heading"></h2>
                {% for rep in reps %}
                    {% include "frontend_module/item_rep.html.twig" %}
                {% endfor %}
            </div>
        </div>
        <link rel="stylesheet" href="{{ asset('bundles/bcsmadridfindrep/css/map.css') }}">
        <script src="{{ asset('bundles/bcsmadridfindrep/js/raphael.min.js') }}"></script>
        <script src="{{ asset('bundles/bcsmadridfindrep/js/settings.js') }}"></script>
        <script src="{{ asset('bundles/bcsmadridfindrep/js/paths.js') }}"></script>
        <script src="{{ asset('bundles/bcsmadridfindrep/js/map.js') }}"></script>
        <script src="{{ asset('bundles/bcsmadridfindrep/js/initialize.js') }}"></script>
        <script src="{{ asset('bundles/bcsmadridfindrep/js/mod_find_your_rep.js') }}"></script>
    {% endif %}
{% endblock %}
