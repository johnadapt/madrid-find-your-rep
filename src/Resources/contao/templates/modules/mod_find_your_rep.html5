<div class="mod_find_your_rep_map">
	<div id='map-container'></div>
</div>
<div class="mod_find_your_rep">
	<div class="rep_list">
		<h2 id="state_heading"></h2>
		<?php
			foreach($this->reps as $rep) {
				echo $rep;
			}
		?>
	</div>
</div>
<?php if (!empty($this->mapComments)): ?>
<script>
(function() {
	var comments = <?= $this->mapComments ?>;
	for (var stateKey in comments) {
		if (!comments.hasOwnProperty(stateKey)) { continue; }
		var html = '';
		for (var i = 0; i < comments[stateKey].length; i++) {
			html += comments[stateKey][i];
		}
		map.setComment(stateKey, html);
	}
})();
</script>
<?php endif; ?>